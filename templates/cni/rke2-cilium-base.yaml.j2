---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
{% if rke2_loadbalancer_ip is defined%}
    k8sServiceHost: {{ rke2_loadbalancer_ip }} # K8s loadbalancer IP for HA
{% else %}
    k8sServiceHost: 127.0.0.1
{% endif %}
    k8sServicePort: 6443
    kubeProxyReplacement: true
    bgp:
      enabled: false
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
    image:
      pullPolicy: IfNotPresent
    operator:
      replicas: {{ groups['rke2_server'] | length | int }}
{% if rke2_cni_l2_enabled %}
    l2announcements:
      enabled: true
{% endif %}
{% if rke2_cni_gateway %}
    gatewayAPI:
      enabled: true
      default: true
      hostNetwork:
        enabled: true
    hostServices:
      enabled: true
    envoy:
      enabled: true
      securityContext:
        capabilities:
          keepCapNetBindService: true
          envoy:
            - BPF
            - CAP_NET_ADMIN
            - CAP_SYS_ADMIN
            - NET_ADMIN
            - NET_BIND_SERVICE
            - SYS_ADMIN
{% endif %}
