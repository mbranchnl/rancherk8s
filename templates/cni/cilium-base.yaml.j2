---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: {{ rancherk8s_type }}-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    k8sServiceHost: {{ rancherk8s_api_endpoint | default('127.0.0.1', true) }} # VIP/LB, or local API
    k8sServicePort: 6443
    kubeProxyReplacement: true
    bgp:
      enabled: false
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
    image:
      pullPolicy: IfNotPresent
    operator:
      replicas: {{ groups['server'] | length | int }}
{% if rancherk8s_cni_l2_enabled %}
    l2announcements:
      enabled: true
{% endif %}
{% if rancherk8s_cni_gateway %}
    {# gatewayAPI:
      enabled: true
      default: true #}
    hostServices:
      enabled: true
    envoy:
      enabled: true
      securityContext:
        capabilities:
          keepCapNetBindService: true
          envoy:
            - BPF
            - CAP_NET_ADMIN
            - CAP_SYS_ADMIN
            - NET_ADMIN
            - NET_BIND_SERVICE
            - SYS_ADMIN
{% endif %}
