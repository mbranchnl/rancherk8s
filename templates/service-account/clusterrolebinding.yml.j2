---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: "clusterrolebinding-{{ rancherk8s_service_account }}"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: "cluster-admin"
subjects:
  - kind: ServiceAccount
    name: "sa-{{ rancherk8s_service_account }}"
    namespace: "kube-system"
