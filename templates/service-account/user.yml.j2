---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: sa-{{ rancherk8s_service_account }}

---
apiVersion: v1
kind: Secret
metadata:
  name: sa-{{ rancherk8s_service_account }}-token
  annotations:
    kubernetes.io/service-account.name: sa-{{ rancherk8s_service_account }}
type: kubernetes.io/service-account-token

